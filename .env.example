# Copiar a .env (no versionar). Sin claves reales: el modo DEMO funciona sin ellas.
APP_ENV=development
APP_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://nicheradar:nicheradar@db:5432/nicheradar
# Clave de YouTube Data API v3 (M1). Déjela vacía para no llamar a YouTube.
# También puede definirse como variable de entorno del usuario de Windows.
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
APP_SECRET_KEY=
AI_PROVIDER=none
COMPLIANCE_MODE=restricted
ADVANCED_ANALYTICS_ENABLED=false
DEMO_MODE=true
DEFAULT_LOOKBACK_DAYS=90
DEFAULT_TARGET_LANGUAGE=es
YOUTUBE_SEARCH_DAILY_SOFT_LIMIT=80
YOUTUBE_OTHER_DAILY_SOFT_LIMIT=8000
SPANISH_QUOTA_RESERVE_PCT=35
RESEARCH_CONFIG_PATH=../config/research.yaml
LOG_LEVEL=INFO
TZ=America/Santiago
BACKEND_PORT=8000
FRONTEND_PORT=5173
